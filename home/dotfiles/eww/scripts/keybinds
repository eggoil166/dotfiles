#!/usr/bin/env bash
# Hyprland binds that have a description (bindd), as JSON rows for eww.
# Rows with the same mods + description are merged: 1..9 -> "1-9", arrows -> "←→↑↓".
hyprctl binds -j | jq -c '
  def mods:
    [ (if (.modmask / 64 | floor) % 2 == 1 then "SUPER" else empty end),
      (if (.modmask / 4  | floor) % 2 == 1 then "CTRL"  else empty end),
      (if (.modmask / 8  | floor) % 2 == 1 then "ALT"   else empty end),
      (if  .modmask             % 2 == 1 then "SHIFT" else empty end) ];
  def pretty:
    { "left": "←", "right": "→", "up": "↑", "down": "↓",
      "Return": "Enter", "slash": "/", "Print": "PrtSc",
      "mouse:272": "LMB", "mouse:273": "RMB" }[.] // .;
  def span:
    if length > 2 and all(.[]; test("^[0-9]$"))
    then "\(.[0])–\(.[-1])"
    else join("") end;

  [ .[] | select(.has_description) | {mods: (mods | join(" + ")), key: (.key | pretty), desc: .description} ]
  | reduce .[] as $b ([];
      (map(.mods + "|" + .desc) | index($b.mods + "|" + $b.desc)) as $i
      | if $i == null then . + [$b | .keys = [.key]] else .[$i].keys += [$b.key] end)
  | map({ keys: ([.mods, (.keys | span)] | map(select(. != "")) | join(" + ")), desc })
'
